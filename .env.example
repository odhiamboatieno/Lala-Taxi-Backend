APP_NAME=Laravel
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stderr
# Log generated OTP values so they can be read from container output.
# TESTING ONLY — the value is a live authentication secret.
OTP_LOG_ENABLED=false

# OTP delivery mode.
#   false = live: generate a random code and send it over the SMS gateway.
#   true  = demo: always issue OTP_DEMO_CODE and never call the SMS gateway.
# Leave this unset to fall back to the admin panel's demo_mode / otp_sandbox
# site settings. Switching it here takes precedence over those.
#
# SECURITY: while true, anyone who knows a registered mobile number can sign in
# with the fixed code. Set false on any public deployment.
OTP_DEMO_MODE=false
# The code issued while OTP_DEMO_MODE is true.
OTP_DEMO_CODE=123456

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
BROADCAST_CONNECTION=reverb
CACHE_DRIVER=file
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120
FIREBASE_PREFIX=live
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REVERB_APP_ID=taxi-dispatch
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
REVERB_HOST=your-domain.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
