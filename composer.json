{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "barryvdh/laravel-dompdf": "^3.0.x-dev",
        "braintree/braintree_php": "^6.18",
        "google/apiclient": "^2.16",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "^3.7",
        "joelbutcher/facebook-graph-sdk": "^6.1",
        "kreait/firebase-php": "^7.10",
        "laravel/framework": "^13.0",
        "laravel/reverb": "^1.10",
        "laravel/socialite": "^5.0",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^3.6.4",
        "mollie/laravel-mollie": "^4.1",
        "nyholm/psr7": "^1.2",
        "outhebox/blade-flags": "^1.5",
        "php-http/message": "^1.8",
        "predis/predis": "^3.4",
        "pusher/pusher-php-server": "^7.2",
        "stripe/stripe-php": "^14.8",
        "twilio/sdk": "^8.0",
        "tymon/jwt-auth": "2.x-dev",
        "web-token/jwt-framework": "^4.1",
        "yajra/laravel-datatables-html": "^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.0"
    },

    "config": {

        "optimize-autoloader": false,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {

            "php-http/discovery": true

        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\SaaSDispatch\\": "Modules/SaaSDispatch/",
            "Modules\\ManualBooking\\": "Modules/ManualBooking/",
            "Modules\\UserLevels\\": "Modules/UserLevels/",
            "Modules\\OperationTeam\\": "Modules/OperationTeam/",
            "Modules\\SurgePricing\\": "Modules/SurgePricing/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "files": [
            "app/Http/Start/Helpers.php",
            "app/Support/legacy_helpers.php",
            "app/Support/yajra_datatable_service.php",
            "Modules/SaaSDispatch/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
