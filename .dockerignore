# Git / VCS
.git
.gitignore
.gitattributes
.github

# Runtime / environment
.env
.env.*
!.env.example

# Dependencies (rebuilt inside the image)
vendor
composer
node_modules

# Build artifacts / logs
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
storage/installed
# Runtime uploads, generated receipts/backups and credentials are provisioned
# on the host, never copied into a registry image from a developer workspace.
storage/app/*
!storage/app/.gitignore
credentials/*
bootstrap/cache/*.php
public/trip_file/*
public/error_log
public/build_logs
public/key.txt
public/key_backup.txt
public/otp.txt
*.log

# Deployment / CI files not needed in the image
deploy
Dockerfile
.dockerignore
