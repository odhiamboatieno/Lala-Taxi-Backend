# ============================================================
# LalaTaxi Backend — production environment for the VPS
# Copy this file to your server as `.env` next to docker-compose.yml
# and fill in real values. Keep it out of version control.
# ============================================================

# --- Application ---
APP_NAME=LalaTaxi
APP_ENV=production
APP_DEBUG=false
APP_URL=http://your-server-ip-or-domain
# Generate with: php artisan key:generate --force  (run inside the app container)
APP_KEY=base64:change-me

# --- Logging ---
LOG_CHANNEL=stderr
# Writes generated OTP values to the log so they can be read from
# `docker compose logs app`. TESTING ONLY — the value is a live
# authentication secret. Keep false on any real deployment.
OTP_LOG_ENABLED=false

# --- Database (host = compose service name) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lalataxi
DB_USERNAME=lalataxi
DB_PASSWORD=change-me-strong
# Used by the mysql container (only used on first volume creation)
MYSQL_ROOT_PASSWORD=change-me-root

# --- Broadcast (Realtime) ---
BROADCAST_DRIVER=log
BROADCAST_CONNECTION=reverb

# --- Cache / Queue ---
CACHE_DRIVER=file
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120
FIREBASE_PREFIX=live

# --- Redis (host = compose service name) ---
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# --- Reverb (WebSockets) ---
# If TLS is terminated in front of the VPS use scheme https + port 443 and
# make sure nginx proxies /app and /apps to the reverb service on 8080.
REVERB_APP_ID=taxi-dispatch
REVERB_APP_KEY=change-me-reverb-key
REVERB_APP_SECRET=change-me-reverb-secret
REVERB_HOST=your-server-ip-or-domain
REVERB_PORT=8080
REVERB_SCHEME=ws
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- JWT (used by the Driver/Rider apps) ---
# MANDATORY: replace this value before the first boot, otherwise every login
# fails with a 500 ("Key provided is shorter than 256 bits").
# The literal placeholder below is 20 characters; HS256 requires at least 32.
# Generate with: php artisan jwt:secret  (run inside the app container)
JWT_SECRET=change-me-jwt-secret

# --- Entrypoint control ---
# Keep "true" on the app service so migrations run once on deploy.
RUN_MIGRATIONS=true
